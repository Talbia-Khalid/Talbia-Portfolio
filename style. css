
/* ===== GENERAL DESIGN ===== */

:root {
  --lavender: #c8a2e8;
  --purple: #9370db;
  --dark: #30243b;
  --light: #fcfaff;
  --soft: #f1e8fa;
}

body {
  background: var(--light) !important;
  color: var(--dark) !important;
  font-family: 'Poppins', sans-serif !important;
}

/* ===== NAVIGATION ===== */

header {
  background: rgba(255, 255, 255, 0.95) !important;
  padding: 20px 8% !important;
  box-shadow: 0 4px 20px #9370db18 !important;
}

.logo {
  color: var(--purple) !important;
  letter-spacing: 1px;
}

nav a {
  transition: color 0.3s ease;
}

nav a:hover {
  color: var(--purple) !important;
}

/* ===== HERO SECTION ===== */

.hero {
  background: linear-gradient(
    135deg,
    #fcfaff,
    #eee1fa,
    #dfc9f2
  ) !important;
}

.tag {
  letter-spacing: 3px !important;
}

h1 span {
  color: var(--purple) !important;
}

.hero p {
  line-height: 2 !important;
}

/* ===== BUTTONS ===== */

.btn {
  transition: all 0.3s ease !important;
}

.primary {
  background: var(--purple) !important;
  box-shadow: 0 6px 18px #9370db40;
}

.primary:hover {
  background: #7955b7 !important;
}

.secondary {
  border-color: var(--purple) !important;
  color: var(--purple) !important;
}

/* ===== SECTIONS ===== */

section {
  scroll-margin-top: 85px;
}

.section-title span {
  color: var(--purple) !important;
}

.about {
  line-height: 2.1 !important;
}

/* ===== SKILLS ===== */

.skills {
  background: #f3ebfb !important;
}

.skill {
  border: 1px solid #e7d7f5;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.skill:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 22px #9370db25;
}

/* ===== CONTACT & FOOTER ===== */

.contact {
  background: #fcfaff;
}

footer {
  background: #30243b !important;
  color: #eee3fa !important;
}

/* ===== MOBILE RESPONSIVENESS ===== */

@media (max-width: 650px) {
  header {
    padding: 18px 5% !important;
  }

  .hero {
    padding: 65px 7% !important;
  }

  h1 {
    font-size: 40px !important;
  }

  nav a {
    margin: 0 6px !important;
  }
}

/* ===== FEATURED PROJECTS ===== */

.projects {
  background: #fcfaff;
}

.projects-intro {
  text-align: center;
  color: #81738c;
  margin: -15px auto 40px;
  max-width: 550px;
  line-height: 1.8;
}

.project-container {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 25px;
  max-width: 1000px;
  margin: auto;
}

.project-card {
  background: white;
  padding: 30px;
  border: 1px solid #eadcf6;
  border-radius: 18px;
  box-shadow: 0 8px 25px #9370db12;
  transition: all 0.3s ease;
}

.project-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 15px 35px #9370db25;
  border-color: #c8a2e8;
}

.project-number {
  color: #a17bc9;
  font-size: 13px;
  font-weight: 600;
}

.project-card h3 {
  color: #49345f;
  margin: 15px 0;
  font-size: 19px;
}

.project-card p {
  color: #81738c;
  font-size: 14px;
  line-height: 1.9;
  margin-bottom: 18px;
}

.project-tech {
  display: block;
  color: #9370db;
  font-size: 12px;
  margin-bottom: 20px;
}

.project-card a {
  display: inline-block;
  color: #8965b5;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
}

.project-card a:hover {
  color: #5e3c8a;
}

.coming-soon {
  display: inline-block;
  background: #f1e8fa;
  color: #8965b5;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 11px;
}

/* Mobile layout */

@media(max-width: 650px) {
  .project-container {
    grid-template-columns: 1fr;
  }

  .project-card {
    padding: 25px;
  }
}

/* ===== EDUCATION SECTION ===== */

.education {
  background: #f5effb;
}

.education-card {
  max-width: 750px;
  margin: auto;
  display: flex;
  align-items: flex-start;
  gap: 22px;
  padding: 30px;
  background: white;
  border: 1px solid #eadcf6;
  border-radius: 18px;
  box-shadow: 0 8px 25px #9370db12;
}

.education-icon {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  background: #eee2fa;
  color: #9370db;
  border-radius: 14px;
  font-size: 23px;
}

.education-label {
  color: #9370db;
  font-size: 11px;
  letter-spacing: 2px;
}

.education-card h3 {
  margin: 10px 0;
  color: #49345f;
  font-size: 19px;
}

.education-card p {
  color: #81738c;
  line-height: 1.8;
}

.education-status {
  display: inline-block;
  margin-top: 12px;
  padding: 6px 13px;
  background: #f1e8fa;
  color: #8965b5;
  border-radius: 20px;
  font-size: 12px;
}

@media(max-width: 500px) {
  .education-card {
    padding: 22px;
    gap: 14px;
  }

  .education-card h3 {
    font-size: 16px;
  }
}

